{
    "name": "kissifrot/php-ixr",
    "type": "library",
    "description": "Incutio XML-RPC library (IXR)",
    "keywords": ["xmlrpc","xlm-rpc", "remote procedure call", "rpc"],
    "homepage": "http://scripts.incutio.com/xmlrpc/",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Incutio Ltd 2010 - Simon Willison",
            "homepage": "http://scripts.incutio.com/xmlrpc/",
            "role": "Original Author"
        },
        {
            "name": "Philippe Villiers",
            "homepage": "https://github.com/kissifrot",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-curl": "Mandatory for ClientSSL class"
    },
    "autoload": {
        "psr-4": {
            "IXR\\tests\\": "tests/",
            "IXR\\": "src/"
        }
    }
}
